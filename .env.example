# Postgres connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ofwild

# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=change-me

# Public URL of the site (no trailing slash)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Cloud storage (leave S3_BUCKET empty to store files on local disk in development)
# AWS S3:        set S3_REGION, leave S3_ENDPOINT empty
# Backblaze B2:  S3_ENDPOINT=https://s3.<region>.backblazeb2.com
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
